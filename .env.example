# Copy to .env (gitignored) and fill in to enable the G30 live agent reasoner.
# The core never auto-reads these; only the explicit live-model factory does,
# and only when you run a live escalation loop.

# Anthropic (Claude Sonnet) — used when provider=anthropic
ANTHROPIC_API_KEY=

# OpenAI — used when provider=openai
OPENAI_API_KEY=
